{
  "name": "@aibrush/media",
  "version": "0.0.0",
  "description": "A browser-first media engine for inspecting, decoding, encoding, converting, muxing, remuxing, and trimming media.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiBrush/media.git"
  },
  "bugs": {
    "url": "https://github.com/AiBrush/media/issues"
  },
  "homepage": "https://github.com/AiBrush/media#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "media",
    "video",
    "audio",
    "transcode",
    "webcodecs",
    "wasm",
    "mp4",
    "webm",
    "browser",
    "esm"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./mp4-packet-info": {
      "types": "./dist/mp4-packet-info.d.ts",
      "import": "./dist/mp4-packet-info.js"
    },
    "./hls": {
      "types": "./dist/hls.d.ts",
      "import": "./dist/hls.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./wav": {
      "types": "./dist/wav.d.ts",
      "import": "./dist/wav.js"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.ts",
      "import": "./dist/drivers/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "browser": {
    "module": false,
    "node:module": false,
    "fs": false,
    "node:fs": false,
    "path": false,
    "node:path": false,
    "crypto": false,
    "os": false,
    "url": false,
    "worker_threads": false
  },
  "files": ["dist", "docs", "examples"],
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "docs:check": "node ./node_modules/typescript/bin/tsc -p tsconfig.examples.json && bun run scripts/check-docs.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:dist": "vitest run src/dist-smoke.test.ts",
    "build": "bun ./scripts/build.mjs",
    "vendor-wasm": "bun run scripts/vendor-wasm.ts",
    "vendor-wasm:check": "bun run scripts/vendor-wasm.ts --check",
    "verify:package": "bun run vendor-wasm:check && bun run scripts/verify-package-install.ts",
    "check-budgets": "bun run scripts/check-budgets.ts",
    "fetch-fixtures": "bun run scripts/fetch-fixtures.ts",
    "verify:integrity": "bun run scripts/anti-cheat.ts",
    "gate": "bun run fetch-fixtures && bun run typecheck && bun run docs:check && biome check . && vitest run --coverage && bun run build && bun run vendor-wasm && bun run test:dist && bun run check-budgets && bun run verify:package && bun run verify:integrity"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@webgpu/types": "^0.1.72",
    "bun-types": "^1.4.1",
    "esbuild": "^0.27.7",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
