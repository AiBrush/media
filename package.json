{
  "name": "@aibrush/media",
  "version": "0.0.0",
  "description": "A unified, capability-routed, in-browser media engine — routes each operation to the best available substrate (WebCodecs → GPU → WASM → TS) behind a flat, intent-only API.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "media",
    "video",
    "audio",
    "transcode",
    "webcodecs",
    "wasm",
    "mp4",
    "webm",
    "browser",
    "esm"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./wav": {
      "types": "./dist/wav.d.ts",
      "import": "./dist/wav.js"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.ts",
      "import": "./dist/drivers/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "browser": {
    "module": false,
    "node:module": false,
    "fs": false,
    "node:fs": false,
    "path": false,
    "node:path": false,
    "crypto": false,
    "os": false,
    "url": false,
    "worker_threads": false
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:dist": "vitest run src/dist-smoke.test.ts",
    "test:deficit-generator": "node --test docs/perf/gen-deficits.test.mjs",
    "test:session13-ledger-generator": "node --test docs/perf/gen-session13-speed-ledger.test.mjs",
    "build": "bun ./scripts/build.mjs",
    "vendor-wasm": "bun run scripts/vendor-wasm.ts",
    "vendor-wasm:check": "bun run scripts/vendor-wasm.ts --check",
    "verify:package": "bun run vendor-wasm:check && bun run scripts/verify-package-install.ts",
    "check-budgets": "bun run scripts/check-budgets.ts",
    "fetch-fixtures": "bun run scripts/fetch-fixtures.ts",
    "verify:integrity": "bun run scripts/anti-cheat.ts",
    "gate": "bun run typecheck && biome check . && bun run test:deficit-generator && bun run test:session13-ledger-generator && vitest run --coverage && bun run build && bun run vendor-wasm && bun run test:dist && bun run check-budgets && bun run verify:package && bun run verify:integrity"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@webgpu/types": "^0.1.70",
    "bun-types": "^1.3.0",
    "esbuild": "^0.27.7",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
