{
  "name": "@aibrush/media",
  "version": "0.0.0",
  "description": "A unified, capability-routed, in-browser media engine — routes each operation to the best available substrate (WebCodecs → GPU → WASM → TS) behind a flat, intent-only API.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "media",
    "video",
    "audio",
    "transcode",
    "webcodecs",
    "wasm",
    "mp4",
    "webm",
    "browser",
    "esm"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.ts",
      "import": "./dist/drivers/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "browser": {
    "module": false,
    "node:module": false,
    "fs": false,
    "node:fs": false,
    "path": false,
    "node:path": false,
    "crypto": false,
    "os": false,
    "url": false,
    "worker_threads": false
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:dist": "vitest run src/dist-smoke.test.ts",
    "test:deficit-generator": "node --test docs/perf/gen-deficits.test.mjs",
    "test:session13-ledger-generator": "node --test docs/perf/gen-session13-speed-ledger.test.mjs",
    "gen:session13-speed-ledger": "node docs/perf/gen-session13-speed-ledger.mjs",
    "build": "tsup",
    "vendor-wasm": "bun run scripts/vendor-wasm.ts",
    "vendor-wasm:check": "bun run scripts/vendor-wasm.ts --check",
    "verify:package": "bun run vendor-wasm:check && bun run scripts/verify-package-install.ts",
    "check-budgets": "bun run scripts/check-budgets.ts",
    "fetch-fixtures": "bun run scripts/fetch-fixtures.ts",
    "bake-goldens": "bun run scripts/bake-goldens.ts",
    "bench-dsp": "bun run scripts/bench-dsp.ts",
    "bench-audio-stream": "bun run scripts/bench-audio-stream.ts",
    "bench-image": "bun run scripts/bench-image.ts",
    "bench-flac": "bun run scripts/bench-flac.ts",
    "bench-colorspace": "bun run scripts/bench-colorspace.ts",
    "bench-preload": "bun run scripts/bench-preload.ts",
    "bench-chain": "bun run scripts/bench-chain.ts",
    "bench-sources": "bun run scripts/bench-sources.ts",
    "bench-webm-fragment": "bun run scripts/bench-webm-fragment.ts",
    "bench-pool": "bun run scripts/bench-pool.ts",
    "bench-session6-r1": "bun run scripts/bench-session6-r1.ts",
    "bench-session6-r4": "bun run scripts/bench-session6-r4.ts",
    "bench-session9-mp4-packet-table": "bun run scripts/bench-session9-mp4-packet-table.ts",
    "bench-session9-webm-probe": "bun run scripts/bench-session9-webm-probe.ts",
    "bench-session11-mp4-packet-truth": "bun run scripts/bench-session11-mp4-packet-truth.ts",
    "bench-session11-aiff-packets": "bun run scripts/bench-session11-aiff-packets.ts",
    "bench-session11-cenc-decrypt": "bun run scripts/bench-session11-cenc-decrypt.ts",
    "bench-session11-mp4-aac-metadata": "bun run scripts/bench-session11-mp4-aac-metadata.ts",
    "bench-session11-mp4-demux": "bun run scripts/bench-session11-mp4-demux.ts",
    "bench-session11-mp4-fragmented-audio-probe": "bun run scripts/bench-session11-mp4-fragmented-audio-probe.ts",
    "bench-session11-mp4-vfr-mux": "bun run scripts/bench-session11-mp4-vfr-mux.ts",
    "bench-session11-video-decode-acceleration": "bun run scripts/bench-session11-video-decode-acceleration.ts",
    "bench-session11-video-quality-plan": "bun run scripts/bench-session11-video-quality-plan.ts",
    "bench-session11-webm-attachments": "bun run scripts/bench-session11-webm-attachments.ts",
    "bench-session11-webm-attachment-packet-seam": "bun run scripts/bench-session11-webm-attachment-packet-seam.ts",
    "bench-session12-gapless": "bun run scripts/bench-session12-gapless.ts",
    "bench-session12-hls": "bun run scripts/bench-session12-hls.ts",
    "bench-session12-wav-pcm-stream": "bun run scripts/bench-session12-wav-pcm-stream.ts",
    "bench-session13-wav-s24-fused": "bun run scripts/bench-session13-wav-s24-fused.ts",
    "bench-session13-wav-s24-sequential-memory": "bun run scripts/bench-session13-wav-s24-sequential-memory.ts",
    "bench-session13-wav-s24-memory-browser": "node scripts/bench-session13-wav-s24-memory-browser.mjs",
    "bench-session13-video-rate-alpha": "node scripts/bench-session13-video-rate-alpha.mjs",
    "bench-session13-av1-transcode-profile": "node scripts/bench-session13-av1-transcode-profile.mjs",
    "bench-session13-video-decoder-startup-browser": "node scripts/bench-session13-video-decoder-startup-browser.mjs",
    "bench-session13-vp9-runtime-fallback": "bun run scripts/bench-session13-vp9-runtime-fallback.ts",
    "bench-session13-flac-packet-info": "bun run scripts/bench-session13-flac-packet-info.ts",
    "bench-session13-wav-identity-copy": "bun run scripts/bench-session13-wav-identity-copy.ts",
    "bench-session13-wav-cache-memory": "bun run scripts/bench-session13-wav-cache-memory.ts",
    "bench-session13-mp4-demux-layout": "bun run scripts/bench-session13-mp4-demux-layout.ts",
    "bench-session13-large-mp4-probe": "bun run scripts/bench-session13-large-mp4-probe.ts",
    "bench-session13-mp4-metadata-direct": "bun run scripts/bench-session13-mp4-metadata-direct.ts",
    "bench-session13-native-packet-fusion": "bun run scripts/bench-session13-native-packet-fusion.ts",
    "bench-session13-mux-track-shapes": "bun run scripts/bench-session13-mux-track-shapes.ts",
    "bench-session13-mp4-prepared-mov": "bun run scripts/bench-session13-mp4-prepared-mov.ts",
    "bench-session13-mp4-public-fixed-cost": "bun run scripts/bench-session13-mp4-public-fixed-cost.ts",
    "bench-session13-collect-single-chunk": "bun run scripts/bench-session13-collect-single-chunk.ts",
    "bench-session13-webm-metadata-window": "bun run scripts/bench-session13-webm-metadata-window.ts",
    "bench-session13-webm-keyframe-prefix": "bun run scripts/bench-session13-webm-keyframe-prefix.ts",
    "bench-session13-webm-terminal-timeline": "bun run scripts/bench-session13-webm-terminal-timeline.ts",
    "bench-session13-webm-demux-packet-table": "bun run scripts/bench-session13-webm-demux-packet-table.ts",
    "bench-session13-hinted-container-probe-browser": "node scripts/bench-session13-hinted-container-probe-browser.mjs",
    "bench-session13-mp4-multitrack-array-crossover": "bun run scripts/bench-session13-mp4-multitrack-array-crossover.ts",
    "bench-session13-mp4-avc-in-memory": "bun run scripts/bench-session13-mp4-avc-in-memory.ts",
    "bench-session13-mp4-packet-lifetime": "bun run scripts/bench-session13-mp4-packet-lifetime.ts",
    "bench-session13-mp4-demux-boundary-browser": "bun run scripts/bench-session13-mp4-demux-boundary-browser.mjs",
    "bench-session13-webm-host-payload-copy": "bun run scripts/bench-session13-webm-host-payload-copy.ts",
    "bench-session13-webm-host-payload-copy-browser": "node scripts/bench-session13-webm-host-payload-copy-browser.mjs",
    "bench-session13-audio-fixed-cost": "bun run scripts/bench-session13-audio-fixed-cost.ts",
    "bench-session13-aac-opus-cadence": "bun run scripts/bench-session13-aac-opus-cadence.ts",
    "bench-session13-semantic-stream-copy": "bun run scripts/bench-session13-semantic-stream-copy.ts",
    "bench-session13-selective-default-container": "bun run scripts/bench-session13-selective-default-container.ts",
    "bench-session13-semantic-vp9-alpha": "bun run scripts/bench-session13-semantic-vp9-alpha.ts",
    "bench-session12-wav-frame-encode": "bun run scripts/bench-session12-wav-frame-encode.ts",
    "bench-session12-stream-input": "bun run scripts/bench-session12-stream-input.ts",
    "bench-session12-container-routing-aes": "bun run scripts/bench-session12-container-routing-aes.ts",
    "bench-session12-flac-ogg-route": "bun run scripts/bench-session12-flac-ogg-route.ts",
    "bench-session12-runtime-controls": "bun run scripts/bench-session12-runtime-controls.ts",
    "bench-session12-job-runner": "bun run scripts/bench-session12-job-runner.ts",
    "bench-session12-live-media": "bun run scripts/bench-session12-live-media.ts",
    "bench-session12-remux-metadata": "bun run scripts/bench-session12-remux-metadata.ts",
    "bench-session12-high-bit-depth-profiles": "bun run scripts/bench-session12-high-bit-depth-profiles.ts",
    "bench-session12-webm-high-depth-reimport": "bun run scripts/bench-session12-webm-high-depth-reimport.ts",
    "bench-session12-packet-drain": "bun run scripts/bench-session12-packet-drain.ts",
    "proof-session12-live-media": "bun run scripts/bench-session12-live-media.mjs",
    "proof-session12-gapless": "node scripts/session12-gapless-browser-proof.mjs",
    "bench-session12-remix": "bun run scripts/bench-session12-remix.ts",
    "bench-session12-resample": "bun run scripts/bench-session12-resample.ts",
    "bench-session12-deterministic-routing": "bun run scripts/bench-session12-deterministic-routing.ts",
    "bench-session12-video-pad": "bun run scripts/bench-session12-video-pad.ts",
    "proof-session12-hls": "node scripts/session12-hls-browser-proof.mjs",
    "proof-session12-video": "node scripts/session12-video-browser-proof.mjs",
    "repair:session12-public-truth": "node scripts/session12-public-truth-repairs.mjs",
    "repair:session12-catalog-inputs": "node scripts/session12-catalog-input-requirements.mjs",
    "verify:session11-webm-attachments-browser": "node scripts/verify-session11-mkv-attachments-browser.mjs",
    "bench-session11-webm-packets": "bun run scripts/bench-session11-webm-packets.ts",
    "verify:integrity": "bun run scripts/anti-cheat.ts",
    "gate": "bun run typecheck && biome check . && bun run test:deficit-generator && bun run test:session13-ledger-generator && vitest run --coverage && tsup && bun run vendor-wasm && bun run test:dist && bun run check-budgets && bun run verify:package && bun run verify:integrity"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@webgpu/types": "^0.1.70",
    "bun-types": "^1.3.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
